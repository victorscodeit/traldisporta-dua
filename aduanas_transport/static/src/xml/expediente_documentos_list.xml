<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="aduanas_transport.DocumentosListView.Buttons" t-inherit="web.ListView.Buttons" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_list_buttons')]" position="inside">
            <button type="button" class="btn btn-primary" t-on-click="onClickSubirDocumento">
                <i class="fa fa-upload"/> Subir documento
            </button>
        </xpath>
    </t>
</templates>
